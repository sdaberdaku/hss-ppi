#!/bin/bash

#SBATCH --job-name hss-ppi
#SBATCH --output output_%j.txt
#SBATCH --error errors_%j.txt
#SBATCH --ntasks 1
#SBATCH --time 12:00:00
#SBATCH --mem 500G

# Submit from the repository root, with the train.py options after the script name:
#   sbatch interface_prediction_slurm.job --protein_class A --is_bound
cd "$SLURM_SUBMIT_DIR"

export OMP_NUM_THREADS=32
srun singularity exec hss-ppi.sif python3 train.py "$@"
